{
  "name": "webgpu-hud",
  "version": "1.0.0",
  "description": "Volumetric cyberpunk HUD on Three.js WebGPURenderer (TSL node materials) with automatic WebGL2 fallback.",
  "license": "MIT",
  "author": "Herman Hoffman",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4791 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
